// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 租戶根節點：SaaS 化之後每間自助註冊的公司對應一筆。
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles       Role[]
  memberships CompanyMembership[]

  @@map("aibpo_companies")
}

// 角色：決定選單可視範圍與資料可視範圍（同公司下、同角色互相看得到彼此的資料）。
model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isSystem    Boolean  @default(false) // 系統預設角色，禁止刪除
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id])
  memberships CompanyMembership[]
  roleMenus   RoleMenu[]
  tallies     Tally[]
  dimensions  Dimension[]
  kmSources   KmSource[]
  kmEntries   KmEntry[]
  skills      Skill[]
  agents      Agent[]
  agentDrafts AgentDraft[]
  botTestRuns BotTestRun[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("aibpo_roles")
}

// 一般使用者的「身分」：帳號/密碼/顯示名稱只有一份，跨公司共用。超級管理員不在這張表裡，帳密另外用 Render 環境變數管理。
model User {
  id           String   @id @default(cuid())
  username     String   @unique // 維持全站唯一，登入不用先選公司
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships CompanyMembership[]

  @@map("aibpo_users")
}

// User × Company × Role 樞紐：一人可同時是多間公司的成員，各公司各自一個角色、各自的啟用狀態。
// isActive 放在這裡而不是 User：公司管理員停用某人，只切斷「這間公司」的存取權，不影響這個人在其他公司的帳號。
// passwordHash/displayName 留在 User：這是「人」的屬性，不是「人在某公司」的屬性，全公司共用同一份、同一次變更。
model CompanyMembership {
  id             String   @id @default(cuid())
  userId         String
  companyId      String
  roleId         String
  isCompanyAdmin Boolean  @default(false) // 公司管理員：只能管自己公司的帳號/角色/Prompt 準則
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId]) // 一人在同一間公司只有一筆身分（一個角色）
  @@index([companyId])
  @@index([roleId])
  @@map("aibpo_company_memberships")
}

// 選單項目：新增選單後，要在「選單權限」頁勾選哪些角色可以看到。
model Menu {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  path      String
  icon      String?
  order     Int      @default(0)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Menu?      @relation("MenuChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Menu[]     @relation("MenuChildren")
  roleMenus RoleMenu[]

  @@map("aibpo_menus")
}

// 角色-選單 多對多關聯：這張表就是「選單權限」勾選矩陣的資料來源。
model RoleMenu {
  roleId String
  menuId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("aibpo_role_menus")
}

// 分類樹（大中小分類），最多三層，可以只用大分類、不用中小分類。
model Tally {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  order     Int      @default(0)
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role      Role      @relation(fields: [roleId], references: [id])
  parent    Tally?    @relation("TallyChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Tally[]   @relation("TallyChildren")
  kmEntries KmEntry[]

  @@index([roleId])
  @@map("aibpo_tallies")
}

// 常用維度清單：分析時可重複勾選，也能在分析當下臨時加自由文字（不落地存這張表）。
model Dimension {
  id          String   @id @default(cuid())
  name        String
  description String?
  roleId      String
  createdAt   DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, name])
  @@map("aibpo_dimensions")
}

// 上傳匯入 KM 的來源（PDF 或 URL）。
model KmSource {
  id                   String   @id @default(cuid())
  title                String
  sourceType           String // "PDF" | "URL"
  sourceName           String? // legacy 單檔案名稱，舊資料用；新資料看 sourceFileIds
  sourceUrl            String? // legacy 單網址，舊資料用；新資料看 sourceUrls
  sourceFileId         String? // legacy 單一 Anthropic Files API file_id，舊資料用；新資料看 sourceFileIds
  sourceFileIds        Json? // 新：多檔案時的 [{ fileId, fileName }][]，同一包視為同一個知識來源
  sourceUrls           Json? // 新：多網址時的 string[]，同一包視為同一個知識來源
  rawText              String?  @db.Text
  status               String   @default("PENDING") // PENDING / PROCESSING / DONE / FAILED
  errorMessage         String?
  // RAG 內容：把原文重排清理成乾淨版文件（不是 Q&A 抽取），跟 FAQ 分析各自獨立觸發、各自失敗。
  ragContent           String?  @db.Text
  ragStatus            String   @default("NONE") // NONE / PENDING / PROCESSING / DONE / FAILED
  ragErrorMessage      String?
  // 這一次產生的開始時間：產生完成時只在「還是同一次」才寫回，按了停止或重新產生後，舊請求晚到的結果會被丟掉。
  ragStartedAt         DateTime?
  // Workflow：辨識文件中的客服情境，從既有 Skill 挑選匹配工具，產出待審核的 AgentDraft。
  workflowStatus       String   @default("NONE") // NONE / PENDING / PROCESSING / DONE / FAILED
  workflowErrorMessage String?
  workflowStartedAt    DateTime?
  roleId               String
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  role     Role         @relation(fields: [roleId], references: [id])
  entries  KmEntry[]
  drafts   AgentDraft[]
  botTests BotTestRun[]

  @@index([roleId])
  @@map("aibpo_km_sources")
}

// 把某個來源的題目整批丟給現行機器人（telligent workflow）問一次，結果留存供人工並排比對。
model BotTestRun {
  id           String   @id @default(cuid())
  sourceId     String
  roleId       String
  createdById  String
  status       String   @default("RUNNING") // RUNNING / DONE / FAILED
  total        Int
  completed    Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  source  KmSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  role    Role            @relation(fields: [roleId], references: [id])
  results BotTestResult[]

  @@index([sourceId])
  @@index([roleId])
  @@map("aibpo_bot_test_runs")
}

// 畫面上的題目/標準答案跟著 entry 顯示最新內容；question/expectedAnswer 快照是「實際送出的題目」與「上次比對用的標準答案」，
// 用來判斷送出/比對後題目或答案有沒有被改過，以及題目被刪除（entryId 變 null）時的後備顯示。
model BotTestResult {
  id             String   @id @default(cuid())
  runId          String
  entryId        String? // 對應的 KM 題目；畫面顯示題目最新內容，question/expectedAnswer 是當時實際送出的快照
  order          Int
  question       String   @db.Text
  expectedAnswer String   @db.Text
  customerId     String // 每題一個全新的 customerId，機器人不會帶著前一題的上下文回答
  chatId         String?
  botAnswer      String?  @db.Text
  status         String   @default("PENDING") // PENDING / ANSWERED / TIMEOUT / ERROR
  errorMessage   String?
  // AI 比對標準答案與機器人回答：MATCH（一致）/ MISMATCH（不一致，judgeReason 寫原因）/ ERROR（比對失敗）
  judgeVerdict   String?
  judgeReason    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  run   BotTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  entry KmEntry?   @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([entryId])
  @@map("aibpo_bot_test_results")
}

// AI 從來源分析出來的每一則 FAQ（題目/答案都可以再編輯）。
model KmEntry {
  id             String   @id @default(cuid())
  sourceId       String
  question       String   @db.Text
  answer         String   @db.Text
  tallyId        String?
  dimensionsUsed Json?
  confirmed      Boolean  @default(false) // 在「新增KM」勾選確認後才會進「知識列表」
  // FAQ：一般問答；DOC：依分類範本（第一層分類 > 維度 > 子維度）整理的結構化文件，question 放實體名稱、answer 是 markdown
  kind           String   @default("FAQ")
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  source KmSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tally  Tally?   @relation(fields: [tallyId], references: [id], onDelete: SetNull)
  role   Role     @relation(fields: [roleId], references: [id])

  botTestResults BotTestResult[]

  @@index([sourceId])
  @@index([roleId])
  @@index([confirmed])
  @@map("aibpo_km_entries")
}

// 每次呼叫 Claude API 都記一筆，用來在儀表板統計「目前用了多少 token、預估花費多少」。
// roleId/companyId 不設外鍵：純記錄用途，角色或公司被刪除也不該連帶刪掉歷史用量紀錄；superadmin 觸發的呼叫兩者皆為 null。
model ApiUsageLog {
  id                  String   @id @default(cuid())
  model               String
  purpose             String // 例如 "km_analysis"
  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  roleId              String?
  companyId           String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([companyId])
  @@map("aibpo_api_usage_logs")
}

// 使用者自訂的可重用工具（目前只做 API 呼叫型）：給 AI Agent 對話時當作 tool-use 的工具來源。
model Skill {
  id           String   @id @default(cuid())
  name         String
  description  String   @db.Text // 同時是 UI 標籤與 Anthropic Tool 的 description，AI 靠這個判斷何時該用
  method       String // "GET" | "POST" | "PUT" | "PATCH" | "DELETE"
  urlTemplate  String   @db.Text // 支援 {{param}} 佔位符
  authType     String   @default("NONE") // "NONE" | "BEARER" | "API_KEY_HEADER" | "BASIC"
  authConfig   Json? // 依 authType 存對應欄位，例如 { token } 或 { headerName, value } 或 { username, password }
  headers      Json? // [{ key, value }]，value 也支援 {{param}}
  bodyTemplate String?  @db.Text // JSON 字串樣板，支援 {{param}}，僅 POST/PUT/PATCH 用
  paramsSchema Json // [{ name, type, description, required }]，同時驅動 Anthropic tool 的 input_schema 與樣板替換
  roleId       String
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role        Role         @relation(fields: [roleId], references: [id])
  agentSkills AgentSkill[]

  @@index([roleId])
  @@map("aibpo_skills")
}

// AI Agent：星狀拓樸畫布的中心節點，name/systemPrompt 定義這個 Agent 的角色，實際能力來自掛載的 Skill。
model Agent {
  id           String   @id @default(cuid())
  name         String
  systemPrompt String   @db.Text
  status       String   @default("DRAFT") // "DRAFT" | "ACTIVE"
  roleId       String
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role        Role         @relation(fields: [roleId], references: [id])
  agentSkills AgentSkill[]
  drafts      AgentDraft[]

  @@index([roleId])
  @@map("aibpo_agents")
}

// Agent-Skill 多對多關聯：連線只代表「這個 Skill 在這個 Agent 的工具箱裡」，不代表執行順序。
// positionX/positionY 存畫布上 Skill 衛星節點的座標（Agent 節點本身位置固定寫死在前端，不用存）。
model AgentSkill {
  id        String   @id @default(cuid())
  agentId   String
  skillId   String
  positionX Float    @default(0)
  positionY Float    @default(0)
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@index([agentId])
  @@index([skillId])
  @@map("aibpo_agent_skills")
}

// Workflow 產出的待審核草稿：一份 KmSource 可能同時拆出多個情境、產出多筆草稿，確認後才畢業成正式 Agent。
model AgentDraft {
  id                String   @id @default(cuid())
  sourceId          String
  suggestedName     String
  suggestedPrompt   String   @db.Text
  suggestedSkillIds Json // string[]，AI 從既有 Skill 清單裡精確比對出來的 id，可為空陣列
  unmatchedNote     String?  @db.Text // 這個情境找不到匹配 Skill 時，AI 說明缺什麼樣的工具
  confirmed         Boolean  @default(false)
  confirmedAgentId  String?
  roleId            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  source         KmSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  role           Role     @relation(fields: [roleId], references: [id])
  confirmedAgent Agent?   @relation(fields: [confirmedAgentId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([roleId])
  @@index([confirmed])
  @@map("aibpo_agent_drafts")
}

// 系統層級設定，key-value 存放，每公司各自一份，目前用來放公司管理員定義的「輸出最高準則」，之後有其他設定也能沿用。
model SystemSetting {
  companyId String
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@id([companyId, key])
  @@map("aibpo_system_settings")
}
