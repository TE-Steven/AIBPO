// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 角色：決定選單可視範圍與資料可視範圍（同角色互相看得到彼此的資料）。
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // 系統預設角色，禁止刪除
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  roleMenus  RoleMenu[]
  tallies    Tally[]
  dimensions Dimension[]
  kmSources  KmSource[]
  kmEntries  KmEntry[]
  skills     Skill[]

  @@map("aibpo_roles")
}

// 一般使用者帳號。超級管理員不在這張表裡，帳密另外用 Render 環境變數管理。
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  isActive     Boolean  @default(true)
  roleId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@map("aibpo_users")
}

// 選單項目：新增選單後，要在「選單權限」頁勾選哪些角色可以看到。
model Menu {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  path      String
  icon      String?
  order     Int      @default(0)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Menu?      @relation("MenuChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Menu[]     @relation("MenuChildren")
  roleMenus RoleMenu[]

  @@map("aibpo_menus")
}

// 角色-選單 多對多關聯：這張表就是「選單權限」勾選矩陣的資料來源。
model RoleMenu {
  roleId String
  menuId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("aibpo_role_menus")
}

// 分類樹（大中小分類），最多三層，可以只用大分類、不用中小分類。
model Tally {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  order     Int      @default(0)
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role      Role      @relation(fields: [roleId], references: [id])
  parent    Tally?    @relation("TallyChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Tally[]   @relation("TallyChildren")
  kmEntries KmEntry[]

  @@index([roleId])
  @@map("aibpo_tallies")
}

// 常用維度清單：分析時可重複勾選，也能在分析當下臨時加自由文字（不落地存這張表）。
model Dimension {
  id          String   @id @default(cuid())
  name        String
  description String?
  roleId      String
  createdAt   DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, name])
  @@map("aibpo_dimensions")
}

// 上傳匯入 KM 的來源（PDF 或 URL）。
model KmSource {
  id           String   @id @default(cuid())
  title        String
  sourceType   String // "PDF" | "URL"
  sourceName   String?
  sourceUrl    String?
  sourceFileId String? // Anthropic Files API 的 file_id（PDF 用，上傳後直接引用，不落地存檔案本體）
  rawText      String?  @db.Text
  status       String   @default("PENDING") // PENDING / PROCESSING / DONE / FAILED
  errorMessage String?
  roleId       String
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role    Role      @relation(fields: [roleId], references: [id])
  entries KmEntry[]

  @@index([roleId])
  @@map("aibpo_km_sources")
}

// AI 從來源分析出來的每一則 FAQ（題目/答案都可以再編輯）。
model KmEntry {
  id             String   @id @default(cuid())
  sourceId       String
  question       String   @db.Text
  answer         String   @db.Text
  tallyId        String?
  dimensionsUsed Json?
  confirmed      Boolean  @default(false) // 在「新增KM」勾選確認後才會進「知識列表」
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  source KmSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tally  Tally?   @relation(fields: [tallyId], references: [id], onDelete: SetNull)
  role   Role     @relation(fields: [roleId], references: [id])

  @@index([sourceId])
  @@index([roleId])
  @@index([confirmed])
  @@map("aibpo_km_entries")
}

// 每次呼叫 Claude API 都記一筆，用來在儀表板統計「目前用了多少 token、預估花費多少」。
// roleId 不設外鍵：純記錄用途，角色被刪除也不該連帶刪掉歷史用量紀錄；superadmin 觸發的呼叫沒有 roleId。
model ApiUsageLog {
  id                  String   @id @default(cuid())
  model               String
  purpose             String // 例如 "km_analysis"
  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  roleId              String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@map("aibpo_api_usage_logs")
}

// 使用者自訂的可重用工具（目前只做 API 呼叫型）：給 AI Agent 對話時當作 tool-use 的工具來源。
model Skill {
  id           String   @id @default(cuid())
  name         String
  description  String   @db.Text // 同時是 UI 標籤與 Anthropic Tool 的 description，AI 靠這個判斷何時該用
  method       String // "GET" | "POST" | "PUT" | "PATCH" | "DELETE"
  urlTemplate  String   @db.Text // 支援 {{param}} 佔位符
  authType     String   @default("NONE") // "NONE" | "BEARER" | "API_KEY_HEADER" | "BASIC"
  authConfig   Json? // 依 authType 存對應欄位，例如 { token } 或 { headerName, value } 或 { username, password }
  headers      Json? // [{ key, value }]，value 也支援 {{param}}
  bodyTemplate String?  @db.Text // JSON 字串樣板，支援 {{param}}，僅 POST/PUT/PATCH 用
  paramsSchema Json // [{ name, type, description, required }]，同時驅動 Anthropic tool 的 input_schema 與樣板替換
  roleId       String
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@map("aibpo_skills")
}

// 系統層級設定，key-value 存放，目前用來放超級管理員定義的「輸出最高準則」，之後有其他全域設定也能沿用。
model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("aibpo_system_settings")
}
