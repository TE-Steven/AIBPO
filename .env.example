# 本機開發：可用 `docker compose up -d` 啟動的 Postgres（見 docker-compose.yml）
# 正式環境（Render）：跟 my-app 共用同一個既有 Render Postgres 資料庫，
# 用 ?schema=aibpo 讓 AIBPO 的資料（table 都是 aibpo_ 開頭）跟 my-app 完全分開，
# 也避免兩邊的 Prisma migration 歷史互相打架。實際連線字串請直接在 Render
# 後台設定 DATABASE_URL 環境變數，不要寫進這個檔案或提交進 git。
#
# 不用在連線字串加 sslmode 之類的參數：Render 的 Postgres 用自簽憑證，SSL 行為
# 已經寫死在 src/lib/dbSsl.ts（非 localhost 一律加密但不驗證憑證鏈），不依賴
# 連線字串裡的 query string（不同版本 pg 函式庫解讀不一致，很難從外部除錯）。
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/aibpo?schema=aibpo"

# 超級管理員帳密：不落地資料庫，只認這組環境變數，正式環境務必更換。
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="change-me"

# 簽署登入 session cookie 用的密鑰，正式環境請換成隨機長字串。
SESSION_SECRET="change-me-to-a-random-string"

# KM 匯入分析用，去 console.anthropic.com 申請。
ANTHROPIC_API_KEY="sk-ant-api03-..."
